{
  "name": "dsh-dungeon-master",
  "version": "0.9.0",
  "description": "QQ Bot IM channel and D&D 5e Dungeon Master plugin for DeepSeek Harness (dsh)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "cordis.yml",
    "personas",
    "skills/dnd-module-authoring",
    "!skills/dnd-module-authoring/scripts/**",
    "skills/dnd-rule-extension",
    "skills/qqbot-image-studio/SKILL.md",
    "skills/qqbot-sticker-maker",
    "!skills/qqbot-sticker-maker/resources/**/*.jpg",
    "!skills/qqbot-sticker-maker/resources/**/*.png",
    "!skills/qqbot-sticker-maker/scripts/*.test.*",
    "README.md",
    "README_EN.md",
    "docs/AGENT_GUIDE.md",
    "CHANGELOG.md",
    "CHANGELOG_EN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsdown --config tsdown.client.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run clean && npm run build",
    "lint": "eslint src/",
    "test": "vitest run",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('lib',{recursive:true,force:true})\""
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qqbot",
    "dnd",
    "cordis",
    "plugin"
  ],
  "license": "MIT",
  "author": "SuperChipper",
  "engines": {
    "node": ">=20.3.0",
    "dsh": ">=0.1.0-rc.6 <1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperChipper/dsh-dungeon-master.git"
  },
  "homepage": "https://github.com/SuperChipper/dsh-dungeon-master#readme",
  "bugs": {
    "url": "https://github.com/SuperChipper/dsh-dungeon-master/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.0-rc.8": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.5": "compatible"
      },
      "note": "已在 DSH 0.1.0-rc.8（CLI / dsh web 扫码、手动、解绑全流程）、0.2.0-rc.2 / 0.2.1-rc.5 / 0.2.2-rc.5（Desktop 内嵌运行时、设置席位与侧栏 HMR 收敛）验证通过；宿主大版本升级后请重新验收席位行为。"
    }
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "^1.0.5",
    "js-yaml": "^4.1.0",
    "qrcode": "^1.5.4",
    "silk-wasm": "^3.7.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <1.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <1.0.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <1.0.0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.6 <1.0.0",
    "@deepseek-ai/schemastery": ">=3.18.1",
    "@tencent-connect/qqbot-connector": "1.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/schemastery": {
      "optional": false
    },
    "@deepseek-ai/dsh-agent": {
      "optional": false
    },
    "@deepseek-ai/dsh-session": {
      "optional": false
    },
    "@deepseek-ai/dsh-llm": {
      "optional": false
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  }
}
